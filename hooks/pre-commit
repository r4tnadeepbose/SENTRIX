#!/bin/sh
# KeySentry pre-commit gate: block commits that introduce secrets.
ROOT="$(git rev-parse --show-toplevel)"
KEYSENTRY_HOME="${KEYSENTRY_HOME:-$(cd "$ROOT/../KeySentry" 2>/dev/null && pwd)}"
if [ -z "$KEYSENTRY_HOME" ] || [ ! -f "$KEYSENTRY_HOME/run.py" ]; then
  echo "KeySentry: installation not found; set KEYSENTRY_HOME to your KeySentry folder." >&2
  exit 0
fi
python "$KEYSENTRY_HOME/run.py" gate --staged --repo "$ROOT"